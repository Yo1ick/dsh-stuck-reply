  "exports": { ".": { "default": "./index.js" } },
  "files": ["index.js", "lib", "standalone.mjs", "cordis.patch.yml", "config.example.yaml", "README.md"],
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
